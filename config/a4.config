# ---- LG Acanvas A4 (i.MX6 Solo) overlay on imx_v6_v7_defconfig ----
# boot chain: stock U-Boot 2014.04 does "bootz ${loadaddr}" with ATAGs -> need appended DTB + ATAG compat
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE="console=ttymxc0,115200"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_AUTO_ZRELADDR=y
# early visibility on UART1 (ttymxc0)
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_IMX6Q_UART=y
CONFIG_DEBUG_IMX_UART_PORT=1
CONFIG_EARLY_PRINTK=y
# keep zImage well under the 8 MiB kernel slot
CONFIG_KERNEL_XZ=y
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_GZIP is not set
# only i.MX6Q/DL/S in this kernel
# CONFIG_SOC_IMX31 is not set
# CONFIG_SOC_IMX35 is not set
# CONFIG_SOC_IMX50 is not set
# CONFIG_SOC_IMX51 is not set
# CONFIG_SOC_IMX53 is not set
CONFIG_SOC_IMX6Q=y
# CONFIG_SOC_IMX6SL is not set
# CONFIG_SOC_IMX6SLL is not set
# CONFIG_SOC_IMX6SX is not set
# CONFIG_SOC_IMX6UL is not set
# CONFIG_SOC_IMX7D is not set
# CONFIG_SOC_IMX7ULP is not set
# CONFIG_SOC_LS1021A is not set
# CONFIG_SOC_VF610 is not set
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_ARM_IMX6Q_CPUFREQ=y
CONFIG_IMX_THERMAL=y
# self-description
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOCALVERSION="-lge-a4"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# storage
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_SPI_IMX=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
# PMIC / power
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_ANATOP=y
CONFIG_REGULATOR_PFUZE100=y
CONFIG_IMX2_WDT=y
CONFIG_RTC_DRV_SNVS=y
# PCIe + Intel 3160 Wi-Fi + Intel BT
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_IMX6=y
CONFIG_PCI_IMX6_HOST=y
CONFIG_PCIEPORTBUS=y
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
# CONFIG_IWLDVM is not set
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_INTEL=m
# display: IPUv3 -> dual-channel LVDS 1080p, etnaviv GPU
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_IMX=y
CONFIG_DRM_IMX_LDB=y
CONFIG_DRM_IMX_HDMI=y
CONFIG_DRM_ETNAVIV=y
CONFIG_IMX_IPUV3_CORE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_IMX27=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=192
# input
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
# USB host (Intel BT dongle) + gadget stack off for now
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_MXS_PHY=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
# on-board FEC as in the vendor kernel: enabled even without the flex-cable port module (PHY scan then fails, eth0 stays down)
CONFIG_FEC=y
CONFIG_REALTEK_PHY=y
# not on this board: no audio codec, no camera, no touch
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_CODA=m
# CONFIG_TOUCHSCREEN_EGALAX is not set
# leaner image
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
CONFIG_NFS_FS=m
CONFIG_NFS_V4=y
# CONFIG_NFSD is not set
CONFIG_CIFS=m
CONFIG_IPV6=y
# generic LVDS panel driver for the panel-lvds node
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_LVDS=y
# CONFIG_DRM_IMX_HDMI is not set
# CONFIG_DRM_DW_HDMI is not set
# battery pack gauge (BATTERY connector), sensors on Light / eCompass connectors
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_SBS=y
CONFIG_IIO=y
CONFIG_MAG3110=y
CONFIG_SENSORS_ISL29018=y
CONFIG_MMA8452=y
# single micro-USB port: device mode too (USB ethernet / serial / mass storage to a PC)
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_ETH=m
CONFIG_USB_ETH_RNDIS=y
CONFIG_USB_G_SERIAL=m
CONFIG_USB_MASS_STORAGE=m
CONFIG_GPIO_SYSFS=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# CODA960 VPU (hardware video decode/encode) via V4L2 mem2mem
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_CAMERA_SUPPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_CODA=m
CONFIG_VIDEO_IMX_PXP=m
# built as modules so udev loads them after the rootfs (firmware) is available

# ---- 2026-10-04: application platform (snapd/Ubuntu Frame, Chromium/Electron, Kodi, RetroArch, Doom) ----
# snaps are squashfs images mounted via loop; AppArmor gives snapd full confinement
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor"
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
# unprivileged sandboxes (Chromium, Electron/MagicMirror) without the SUID helper; containers
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# audio: no on-board codec; USB/Bluetooth audio and virtual devices for apps that require ALSA
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_HRTIMER=m
CONFIG_SND_DUMMY=m
CONFIG_SND_ALOOP=m
CONFIG_SND_SEQUENCER=m
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m
CONFIG_BT_HIDP=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
# input: gamepads / remotes for RetroArch, Doom, Kodi
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID_GENERIC=y
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_STEAM=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_APPLE=m
CONFIG_USB_HIDDEV=y
# storage/media for Kodi libraries on USB or network
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# 1 GiB RAM: compressed swap for Chromium/Kodi
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_SWAP=y
CONFIG_TUN=m
CONFIG_BINFMT_MISC=m
